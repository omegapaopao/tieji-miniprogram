/**
 * 记录页 — 样式（含动画增强）
 */

/* 动作头部 */
.action-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(245, 166, 35, 0.06);
}

.action-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.action-category {
  font-size: 24rpx;
  color: #f5a623;
  background: rgba(245, 166, 35, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

/* 1RM 展示 */
.one-rm-display {
  text-align: right;
}

.one-rm-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.one-rm-big {
  font-size: 56rpx;
  font-weight: 700;
  color: #f5a623;
  line-height: 1;
  transition: transform 0.15s ease;
}

.one-rm-unit {
  font-size: 22rpx;
  color: #999;
}

/* 输入区域 */
.input-section {
  margin-bottom: 24rpx;
}

.input-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.input-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #ccc;
  font-weight: 500;
}

.input-unit {
  width: 60rpx;
  font-size: 28rpx;
  color: #999;
  text-align: right;
}

/* 步进器 */
.stepper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #1a1a1a;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid transparent;
  transition: border-color 0.2s;
}

.stepper:focus-within {
  border-color: #f5a623;
}

.stepper-btn {
  width: 80rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #333;
  transition: background 0.15s, transform 0.1s;
}

.stepper-btn-active {
  background: #444;
  transform: scale(0.93);
}

.stepper-symbol {
  font-size: 36rpx;
  color: #f5a623;
  font-weight: 600;
}

.stepper-input {
  flex: 1;
  height: 72rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  background: #1a1a1a;
}

/* 计算值展示 */
.calc-row {
  display: flex;
  padding-top: 20rpx;
  border-top: 1rpx solid #3a3a3a;
}

.calc-item {
  flex: 1;
  text-align: center;
}

.calc-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #f5a623;
  margin-bottom: 4rpx;
}

.calc-label {
  font-size: 22rpx;
  color: #666;
}

/* 计时器区域 */
.timer-section {
  margin-bottom: 24rpx;
}

.timer-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 0;
  border-radius: 12rpx;
  transition: background 0.2s;
}

.timer-toggle-icon {
  font-size: 20rpx;
  color: #f5a623;
  transition: transform 0.3s;
}

.timer-toggle-text {
  font-size: 26rpx;
  color: #999;
}

.timer-content {
  margin-top: 10rpx;
}

/* 保存按钮 */
.save-section {
  padding: 20rpx 0 40rpx;
}

.save-btn {
  margin-bottom: 24rpx;
  font-size: 34rpx !important;
  transition: transform 0.12s ease, opacity 0.12s ease;
  box-shadow: 0 4rpx 20rpx rgba(245, 166, 35, 0.25);
}

.save-btn-text {
  letter-spacing: 2rpx;
}

/* AI 分析入口 */
.ai-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  color: #999;
  font-size: 26rpx;
  border-radius: 12rpx;
  transition: background 0.2s, color 0.2s;
}

.ai-entry-hover {
  color: #f5a623;
  background: rgba(245, 166, 35, 0.06);
}

.ai-arrow {
  color: #f5a623;
  font-size: 28rpx;
  transition: transform 0.2s;
}

.ai-entry-hover .ai-arrow {
  transform: translateX(6rpx);
}

/* ========== 保存成功浮层 ========== */
.success-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-card {
  background: #1a1a1a;
  border: 2rpx solid #f5a623;
  border-radius: 24rpx;
  padding: 60rpx 50rpx;
  text-align: center;
  width: 500rpx;
}

.success-check {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4caf50, #66bb6a);
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(76, 175, 80, 0.4);
}

.success-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.success-detail {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.success-1rm {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #f5a623;
}

/* ========== 粒子特效 ========== */
.particle-burst {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 9998;
  pointer-events: none;
  width: 0;
  height: 0;
}

.particle {
  position: absolute;
  border-radius: 50%;
  animation: particleUp 0.7s ease-out forwards;
}

@keyframes particleUp {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(0);
  }
}
