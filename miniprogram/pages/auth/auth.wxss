/**
 * 登录/注册页 — 样式
 */

/* 品牌区 */
.brand-section {
  text-align: center;
  padding: 80rpx 0 50rpx;
}

.brand-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  display: inline-block;
}

.brand-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  margin-bottom: 8rpx;
}

.brand-desc {
  font-size: 24rpx;
  color: #888;
  letter-spacing: 4rpx;
}

/* 切换标签 */
.auth-tabs {
  display: flex;
  margin-bottom: 40rpx;
  background: #2a2a2a;
  border-radius: 16rpx;
  padding: 6rpx;
}

.auth-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #888;
  border-radius: 12rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.auth-tab.active {
  background: linear-gradient(135deg, #f5a623, #f7931e);
  color: #1a1a1a;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(245, 166, 35, 0.3);
}

/* 表单卡片 */
.form-card {
  background: #2a2a2a;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
}

/* 头像上传 */
.avatar-upload {
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}

.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #f5a623;
  box-shadow: 0 4rpx 20rpx rgba(245, 166, 35, 0.25);
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 3rpx dashed #555;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.avatar-placeholder:active {
  border-color: #f5a623;
  background: rgba(245, 166, 35, 0.06);
}

.avatar-placeholder-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.avatar-placeholder-text {
  font-size: 20rpx;
  color: #888;
}

/* 输入组 */
.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #ccc;
  margin-bottom: 10rpx;
  padding-left: 4rpx;
}

.form-input {
  background: #1a1a1a;
  border-radius: 14rpx;
  padding: 22rpx 20rpx;
  font-size: 28rpx;
  color: #fff;
  border: 2rpx solid transparent;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

.form-input:focus {
  border-color: #f5a623;
  box-shadow: 0 0 0 4rpx rgba(245, 166, 35, 0.08);
}

/* 提交按钮 */
.auth-submit-btn {
  margin-top: 30rpx;
  font-size: 30rpx !important;
  letter-spacing: 8rpx;
}

/* 底部切换 */
.auth-footer {
  text-align: center;
  font-size: 26rpx;
  color: #888;
}

.footer-link {
  color: #f5a623;
  font-weight: 500;
  margin-left: 4rpx;
}
