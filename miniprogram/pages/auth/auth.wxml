<!--
  登录/注册页
  动画: 卡片缩放弹入 + 头像脉冲呼吸 + 输入框聚焦高亮
-->
<view class="container">
  <!-- Logo / 品牌 -->
  <view class="brand-section scale-in">
    <view class="brand-icon">🏋️</view>
    <text class="brand-name">铁 记</text>
    <text class="brand-desc">力量训练日志</text>
  </view>

  <!-- 登录/注册 切换标签 -->
  <view class="auth-tabs fade-in">
    <view
      class="auth-tab {{mode === 'login' ? 'active' : ''}}"
      data-mode="login"
      bindtap="switchMode"
    >
      <text>登录</text>
    </view>
    <view
      class="auth-tab {{mode === 'register' ? 'active' : ''}}"
      data-mode="register"
      bindtap="switchMode"
    >
      <text>注册</text>
    </view>
  </view>

  <!-- 登录表单 -->
  <view wx:if="{{mode === 'login'}}" class="form-card scale-in">
    <view class="input-group">
      <text class="input-label">用户名</text>
      <input
        class="form-input"
        placeholder="请输入用户名"
        placeholder-style="color:#555"
        value="{{loginUsername}}"
        bindinput="onLoginUsernameInput"
      />
    </view>
    <view class="input-group">
      <text class="input-label">密码</text>
      <input
        class="form-input"
        type="password"
        placeholder="请输入密码"
        placeholder-style="color:#555"
        value="{{loginPassword}}"
        bindinput="onLoginPasswordInput"
      />
    </view>
    <button
      class="btn-primary auth-submit-btn btn-press"
      bindtap="handleLogin"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      登 录
    </button>
  </view>

  <!-- 注册表单 -->
  <view wx:if="{{mode === 'register'}}" class="form-card scale-in">
    <!-- 头像上传 -->
    <view class="avatar-upload" bindtap="chooseAvatar">
      <image
        wx:if="{{avatarUrl}}"
        class="avatar-preview"
        src="{{avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="avatar-placeholder breathe">
        <text class="avatar-placeholder-icon">📷</text>
        <text class="avatar-placeholder-text">上传头像</text>
      </view>
    </view>

    <view class="input-group">
      <text class="input-label">用户名</text>
      <input
        class="form-input"
        placeholder="2-12 个字符"
        placeholder-style="color:#555"
        value="{{regUsername}}"
        bindinput="onRegUsernameInput"
        maxlength="12"
      />
    </view>
    <view class="input-group">
      <text class="input-label">密码</text>
      <input
        class="form-input"
        type="password"
        placeholder="至少 4 位密码"
        placeholder-style="color:#555"
        value="{{regPassword}}"
        bindinput="onRegPasswordInput"
      />
    </view>
    <view class="input-group">
      <text class="input-label">确认密码</text>
      <input
        class="form-input"
        type="password"
        placeholder="再次输入密码"
        placeholder-style="color:#555"
        value="{{regPasswordConfirm}}"
        bindinput="onRegPasswordConfirmInput"
      />
    </view>
    <button
      class="btn-primary auth-submit-btn btn-press"
      bindtap="handleRegister"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      注 册
    </button>
  </view>

  <!-- 底部提示 -->
  <view class="auth-footer fade-in">
    <text wx:if="{{mode === 'login'}}">还没有账号？</text>
    <text wx:else>已有账号？</text>
    <text
      class="footer-link"
      data-mode="{{mode === 'login' ? 'register' : 'login'}}"
      bindtap="switchMode"
    >{{mode === 'login' ? '立即注册' : '去登录'}}</text>
  </view>
</view>
