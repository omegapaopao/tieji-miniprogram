/**
 * AI 动作分析页 — 样式
 * 专业深色卡片 + 金色评分 + 占位关键帧
 */

/* 上传区域 */
.upload-card {
  text-align: center;
  padding: 60rpx 30rpx;
  margin-bottom: 24rpx;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  display: block;
}

.upload-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.upload-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
  line-height: 1.6;
  white-space: pre-line;
}

.upload-actions {
  margin-bottom: 24rpx;
}

.upload-btn {
  margin-bottom: 12rpx;
  padding: 24rpx 60rpx !important;
  display: inline-flex !important;
  width: auto;
}

.upload-hint {
  display: block;
  font-size: 22rpx;
  color: #666;
}

.action-link {
  padding-top: 20rpx;
  border-top: 1rpx solid #3a3a3a;
}

.action-link-label {
  font-size: 24rpx;
  color: #666;
}

.action-link-value {
  font-size: 24rpx;
  color: #f5a623;
}

/* 说明卡片 */
.info-card {
  margin-bottom: 24rpx;
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.info-dot {
  color: #f5a623;
}

/* 视频预览 */
.preview-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.preview-video {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #000;
  margin-bottom: 20rpx;
}

.preview-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.preview-actions .btn-small {
  width: 180rpx;
  text-align: center;
  padding: 16rpx 0 !important;
}

/* 分析中动画 */
.analyzing-card {
  text-align: center;
  padding: 80rpx 30rpx;
}

.spinner {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 30rpx;
}

.spinner-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #333;
  border-top-color: #f5a623;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.spinner-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
}

.analyzing-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.analyzing-step {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}

/* 进度条 */
.progress-bar {
  width: 80%;
  height: 6rpx;
  background: #333;
  border-radius: 3rpx;
  margin: 0 auto;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f5a623, #f7931e);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

/* ====== 分析报告 ====== */

/* 评分卡片 */
.score-card {
  text-align: center;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
}

.score-header {
  margin-bottom: 20rpx;
}

.score-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.score-value {
  font-size: 100rpx;
  font-weight: 700;
  line-height: 1;
}

.score-value.gold {
  color: #f5a623;
}

.score-unit {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-top: 4rpx;
}

.score-action-name {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 16rpx;
}

/* 评分条 */
.score-bar-bg {
  width: 100%;
  height: 10rpx;
  background: #333;
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.score-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #e74c3c, #f5a623, #4caf50);
  border-radius: 5rpx;
  transition: width 0.6s ease;
}

/* 关键帧 */
.keyframes-card {
  margin-bottom: 24rpx;
}

.keyframes-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.keyframe-placeholder {
  flex: 1;
  aspect-ratio: 4/3;
  background: #1a1a1a;
  border: 2rpx dashed #444;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.keyframe-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
  opacity: 0.4;
}

.keyframe-label {
  font-size: 22rpx;
  color: #666;
}

.keyframe-hint {
  display: block;
  font-size: 20rpx;
  color: #555;
  text-align: center;
}

/* 改进建议 */
.suggestions-card {
  margin-bottom: 24rpx;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #333;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(245, 166, 35, 0.2);
  color: #f5a623;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.suggestion-text {
  flex: 1;
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.6;
}

/* 详情 */
.detail-card {
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #2a2a2a;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
}

.detail-value {
  font-size: 26rpx;
  color: #fff;
}

/* 重新分析 */
.reanalyze-btn {
  margin-bottom: 40rpx;
  text-align: center;
}

/* 风险颜色 */
.risk-low  { color: #4caf50 !important; }
.risk-mid  { color: #f5a623 !important; }
