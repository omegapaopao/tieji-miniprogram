<!--
  动作选择器组件
  动画: 标签切换过渡 + 卡片hover缩放
-->
<view class="exercise-picker">
  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view
      wx:for="{{categories}}"
      wx:key="value"
      class="category-tag {{activeCategory === item.value ? 'active' : ''}}"
      data-category="{{item.value}}"
      bindtap="switchCategory"
      hover-class="category-tag-hover"
    >
      <text>{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 动作列表 -->
  <scroll-view class="exercise-scroll" scroll-x enable-flex>
    <!-- 自定义动作入口 -->
    <view class="exercise-item add-new btn-press" bindtap="onAddCustom" hover-class="add-new-hover">
      <view class="exercise-icon add-icon">+</view>
      <text class="exercise-name">自定义</text>
    </view>

    <view
      wx:for="{{filteredExercises}}"
      wx:key="_id"
      class="exercise-item"
      data-exercise="{{item}}"
      bindtap="onSelectExercise"
      bindlongpress="onLongPressExercise"
      hover-class="exercise-item-hover"
    >
      <view class="exercise-icon">💪</view>
      <text class="exercise-name">{{item.name}}</text>
      <text class="exercise-target" wx:if="{{item.target}}">{{item.target}}</text>
      <text class="exercise-category">{{item.category}}</text>
    </view>
  </scroll-view>

  <!-- 动作指导弹窗 -->
  <view wx:if="{{showGuide}}" class="modal-mask" bindtap="closeGuide">
    <view class="modal-box guide-modal scale-in" catchtap="">
      <text class="guide-modal-title">{{guideExercise.name}}</text>
      <view class="guide-modal-tags">
        <text class="tag tag-gold">{{guideExercise.category}}</text>
        <text wx:if="{{guideExercise.displayTarget}}" class="tag tag-blue">{{guideExercise.displayTarget}}</text>
      </view>
      <text class="guide-modal-text">{{guideExercise.displayGuide || '暂无动作指导'}}</text>
      <view class="modal-btns" style="margin-top:24rpx">
        <button class="btn-primary btn-small btn-press" bindtap="closeGuide">知道了</button>
      </view>
    </view>
  </view>
</view>
